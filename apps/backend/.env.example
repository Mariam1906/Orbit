# ---------------------------------------------------------------------------
# Orbit Merchant API — environment template
# ---------------------------------------------------------------------------
#   cp .env.example .env    then fill in the secrets.
# `.env` is gitignored; this template is committed so the config shape is known.
# ---------------------------------------------------------------------------

PORT=3001

# --- Supabase ----------------------------------------------------------------
# >>> SECRET <<< Service-role key. Server-side only — never expose to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stellar / Soroban rail --------------------------------------------------
ORBIT_CONTRACT_ID=CAZBZBUWBSQYK2RZ6WHMXVDLIQHSU5WD7ANZYL6HLNSCRUOTNYCDYQNG
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Comma-separated failover RPCs for the public read-only proxy.
# SOROBAN_RPC_URLS=https://soroban-testnet.stellar.org,https://backup-rpc.example
# RPC_PROXY_RATE_LIMIT_MAX=60
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# SAC USDC uses 7 decimals on this rail.
STELLAR_USDC_DECIMALS=7

# --- Ledger reconciliation worker (optional, defaults shown) -----------------
# RECONCILE_INTERVAL_MS=60000
# Ledgers to scan back when no event cursor is stored (~1 day at 5s/ledger)
# RECONCILE_EVENT_LOOKBACK_LEDGERS=17280
# Subscriptions younger than this are not checked against get_vault
# RECONCILE_GRACE_SECONDS=300
# --- Contract event indexer (#101) -------------------------------------------
# Enable by setting the inclusive first ledger to ingest (within RPC retention).
# Saved checkpoints always take precedence after restart. Never reset to skip lag.
# INDEXER_START_LEDGER=
# INDEXER_BATCH_SIZE=100
# INDEXER_INTERVAL_MS=5000
# FRONTEND_URL=http://localhost:3000

# --- Idempotency & billing locks (optional, defaults shown) ------------------
# IDEMPOTENCY_KEY_TTL_SECONDS=86400
# IDEMPOTENCY_IN_PROGRESS_TIMEOUT_SECONDS=300
# PREPARE_LOCK_TTL_SECONDS=60

# --- Gas sponsorship relayer (/relay/* routes) --------------------------------
# >>> SECRET <<< Orbit relayer account: pays the fees of every sponsored pull as the
# fee-bump fee source. Keep it funded with XLM. Unset = /relay/* return 503.
# RELAYER_SECRET_KEY=
# Optional comma-separated channel account secrets used as inner transaction sources,
# one in-flight relay per channel. Defaults to the relayer account alone.
# RELAYER_CHANNEL_SECRET_KEYS=
# Daily sponsored fee budget per merchant, and the cap for any single pull (stroops)
# RELAYER_DAILY_FEE_LIMIT_STROOPS=50000000
# RELAYER_MAX_FEE_STROOPS=5000000
# RELAYER_BASE_FEE=100
# Submission attempts on txBadSeq / TRY_AGAIN_LATER, and max wait for a free channel
# RELAYER_MAX_ATTEMPTS=3
# RELAYER_QUEUE_TIMEOUT_MS=30000
# Ledgers a prepared merchant authorization stays signable (~5s each)
# RELAYER_AUTH_VALIDITY_LEDGERS=100
# Relay requests allowed per merchant per window
# RELAYER_RATE_LIMIT_MAX=10
# RELAYER_RATE_LIMIT_WINDOW_MS=60000
# --- Exchange rate oracle (optional, defaults shown) --------------------------
# Background worker refresh interval for the fiat -> USDC rate cache (5 min)
# ORACLE_SYNC_INTERVAL_MS=300000
# A fiat pull is rejected when the live rate moved more than this from the
# subscription's quoted rate (200 bps = 2%)
# ORACLE_SLIPPAGE_TOLERANCE_BPS=200
# Price feed request timeout (ms)
# ORACLE_FETCH_TIMEOUT_MS=6000

# --- Merchant payout splits (#160) --------------------------------------------
# >>> SECRET <<< Account that signs and pays the on-chain transfers for a settled
# pull's split allocations. Falls back to RELAYER_SECRET_KEY when unset. When no
# key is configured, splits are still recorded as pending for later reconciliation.
# SPLIT_RELAYER_SECRET_KEY=
# Stellar Asset Contract used for split payouts; falls back to USDC_CONTRACT_ID.
# SPLIT_TOKEN_CONTRACT_ID=

# --- Recurring plan price indexation (#164) -----------------------------------
# Delay between price indexation worker runs: notice emails inside the advance
# window, then apply schedules once their effective date arrives (15 min default).
# PRICE_INDEXATION_INTERVAL_MS=900000

# --- Rate limiting (optional, defaults shown) ---------------------------------
# RATE_LIMIT_WINDOW_MS=60000
# API_KEY_RATE_LIMIT_MAX=100
# IP_RATE_LIMIT_MAX=300
# Set when behind a reverse proxy / load balancer so rate limits see the client IP
# TRUST_PROXY=1

# --- Multi-region database replicas & failover (#139) -------------------------
# Comma-separated read replica Supabase URLs for routing eligible idempotent reads
# SUPABASE_READ_REPLICA_URLS=
# Optional replica service role key (defaults to SUPABASE_SERVICE_ROLE_KEY if unset)
# SUPABASE_REPLICA_SERVICE_ROLE_KEY=
# Cooldown window in ms before an unhealthy replica is reprobed (30s)
# REPLICA_COOLDOWN_MS=30000
# Direct Postgres read replica connection string(s) for report streaming
# DATABASE_REPLICA_URLS=

# --- GDPR/CCPA Cryptographic Data Shredding (#138) ----------------------------
# Master Key Encryption Key (KEK) used for per-user envelope encryption (32-byte secret)
# PRIVACY_MASTER_KEY=
# Secret used to HMAC-sign tamper-evident compliance deletion certificates
# PRIVACY_COMPLIANCE_SIGNING_SECRET=
